# The control plane.
#
# Note what is absent: any Before=/Requires=/PartOf= relationship with hostapd
# or dnsmasq. The AP is the anchor and must keep serving when this unit is
# stopped, crashed, or being updated (ADR-011).
#
# Note also the absence of ExecStop cleanup. Kernel state outlives this process
# deliberately, so a control-plane failure degrades adaptivity rather than
# causing an outage (ADR-008). Do not add teardown here.
#
# After=systemd-networkd.service (added 2026-08-08): config.api_host is
# hardcoded to the LAN gateway address, which systemd-networkd assigns to the
# AP interface (lan/__init__.py's networkd_config(), independent of this
# daemon per ADR-011). This unit starting first raised an unhandled OSError
# out of app.run() and crash-looped -- __main__.py now retries that bind
# instead of crashing, so this ordering is defense-in-depth (fewer retries
# needed in the common case), not the only fix.

[Unit]
Description=WI-FUCKED connectivity controller
After=network.target wifucked-firstboot.service systemd-networkd.service
Wants=network.target

[Service]
Type=notify
NotifyAccess=main
Environment=PYTHONPATH=/opt/wifucked/current/src
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m wifucked
Restart=always
RestartSec=5
# A wedged control plane should be restarted, not left wedged. The network keeps
# working across the restart either way. Daemon.run_forever() feeds this every
# fast-loop tick via sd_notify(WATCHDOG=1) (wifucked/watchdog.py); Type=notify
# + NotifyAccess=main above make that keepalive (and READY=1 at startup) count.
WatchdogSec=120
StateDirectory=wifucked

[Install]
WantedBy=multi-user.target
