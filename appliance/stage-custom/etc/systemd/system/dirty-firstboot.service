# Derives LAN identity from the Pi serial, exactly once (ADR-012).

[Unit]
Description=DIRTY first-boot identity generation
Before=hostapd.service dnsmasq.service
After=local-fs.target
ConditionPathExists=!/var/lib/dirty/.identity-generated

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/dirty/firstboot.sh

[Install]
WantedBy=multi-user.target
