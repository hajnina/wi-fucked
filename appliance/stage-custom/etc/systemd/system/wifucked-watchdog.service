# OTA rollback watchdog (SOP-008, ADR-008, ADR-011).
#
# Validates the running version after an update and rolls back to the previous
# slot if it is unhealthy. It touches only the `current` symlink and
# wifucked.service — never hostapd/dnsmasq (the AP is the anchor, ADR-011) and
# never any kernel state (ADR-008). Triggered by wifucked-watchdog.timer, not
# enabled directly.

[Unit]
Description=WI-FUCKED OTA rollback watchdog
After=wifucked.service network.target

[Service]
Type=oneshot
ExecStart=/opt/wifucked/watchdog.sh
