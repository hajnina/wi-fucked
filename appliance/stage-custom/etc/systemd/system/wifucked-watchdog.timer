# Fires the OTA rollback watchdog once, a grace period after boot.
#
# 90s gives wifucked.service (Restart=always, RestartSec=5) real time to come up,
# so "still not answering" is a meaningful signal rather than normal startup
# latency (SOP-008).

[Unit]
Description=WI-FUCKED OTA rollback watchdog timer

[Timer]
OnBootSec=90s
AccuracySec=1s
Unit=wifucked-watchdog.service

[Install]
WantedBy=timers.target
