# OTA rollback watchdog (SOP-008, ADR-008, ADR-011).
#
# Validates the running version after an update and rolls back to the previous
# slot if it is unhealthy. It touches only the `current` symlink and
# dirty.service — never hostapd/dnsmasq (the AP is the anchor, ADR-011) and
# never any kernel state (ADR-008). Triggered by dirty-watchdog.timer, not
# enabled directly.

[Unit]
Description=DIRTY OTA rollback watchdog
After=dirty.service network.target

[Service]
Type=oneshot
ExecStart=/opt/dirty/watchdog.sh
